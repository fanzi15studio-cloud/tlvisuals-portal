# Copiez ce fichier en ".env" puis remplissez-le.
#   cp .env.example .env && nano .env
# Le fichier .env ne doit JAMAIS etre envoye sur GitHub.

# Domaine public de Stirling PDF
HOST=pdf.thomasloiseauvisuals.com

# Compte administrateur initial (remplace admin/stirling par defaut)
STIRLING_ADMIN_USER=thomas
# Generez un mot de passe solide avec :  openssl rand -base64 24
STIRLING_ADMIN_PASSWORD=REMPLACEZ_MOI
