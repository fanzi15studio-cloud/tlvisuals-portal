# =============================================================================
#  Variables a renseigner dans Dokploy (onglet "Environment" du service)
#  ou dans un fichier .env a cote du docker-compose.yml.
#  NE JAMAIS envoyer le fichier .env rempli sur GitHub.
# =============================================================================

# Domaine public de DocuSeal (doit pointer sur l'IP du VPS en DNS type A)
DOCUSEAL_HOST=sign.thomasloiseauvisuals.com

# Cle de chiffrement. Generez-la UNE SEULE FOIS avec :
#     openssl rand -hex 64
# Conservez-la dans votre gestionnaire de mots de passe.
# La changer plus tard rendrait les donnees chiffrees illisibles.
SECRET_KEY_BASE=REMPLACEZ_MOI

# Mot de passe PostgreSQL. Generez-le avec :
#     openssl rand -base64 24
POSTGRES_PASSWORD=REMPLACEZ_MOI

# --- Brevo (plan gratuit : 300 emails/jour, serveurs UE) ---
# Valeurs a recuperer dans Brevo > SMTP & API > SMTP.
# Le mot de passe est une "cle SMTP", pas le mot de passe de votre compte Brevo.
SMTP_ADDRESS=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REMPLACEZ_MOI
SMTP_PASSWORD=REMPLACEZ_MOI
# Domaine d'envoi, celui que vous authentifiez chez Brevo (SPF/DKIM)
SMTP_DOMAIN=thomasloiseauvisuals.com
